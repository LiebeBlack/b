<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Solo dos permisos, ambos normales (no peligrosos): no hay nada que pedir al usuario.
        · INTERNET           -> consultar las APIs de tasas.
        · ACCESS_NETWORK_STATE -> ConnectivityObserver, para no intentar red cuando no hay.
      La app no pide ubicación, contactos, almacenamiento ni cámara.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".DivTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DivTrack.Starting">

        <!--
          WorkManager con inicialización bajo demanda: DivTrackApplication implementa
          Configuration.Provider para inyectarle el HiltWorkerFactory, así que el inicializador
          que androidx.startup lanza al arrancar sobra y además pisaría esa configuración
          (es un error fatal de lint, no un aviso: la app arrancaría con la configuración por
          defecto y el worker se quedaría sin dependencias).

          Se elimina solo ese nodo, no el agregador de startup: otras librerías lo siguen usando.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DivTrack.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
